      "surfaceGlassSubtle": "rgba(74, 59, 120, 0.30)",
      "surfaceGlassBorder": "rgba(255, 255, 255, 0.16)",
      "surfaceGlassBorderSoft": "rgba(255, 255, 255, 0.08)",
      "glassFill": "rgba(74, 59, 120, 0.30)",
      "glassShine": "rgba(255, 255, 255, 0.13)",
      "glassGloss": "rgba(255, 255, 255, 0.02)",
      "glassShineEdge": "rgba(255, 255, 255, 0.16)",
      "glassGlossBorder": "rgba(255, 255, 255, 0.16)",
      "textPrimary": "#F4F1FB",
      "textSecondary": "#D8D0EA",
      "textTertiary": "#AFA3CB",
      "textOnPrimary": "#FFFFFF",
      "textDisabled": "#6B6088",
      "textLink": "#D3C4F0",
      "textLinkHover": "#E3DAF7",
      "colorPrimary": "#9F87E0",
      "colorPrimaryHover": "#B9A6EC",
      "colorPrimaryActive": "#D3C4F0",
      "colorPrimarySoft": "rgba(159, 135, 224, 0.22)",
      "colorSecondary": "#5FBE97",
      "colorSecondarySoft": "rgba(95, 190, 151, 0.18)",
      "colorAccent": "#F2A868",
      "colorAccentSoft": "rgba(242, 168, 104, 0.18)",
      "colorSuccess": "#5FBE97",
      "colorSuccessSoft": "rgba(95, 190, 151, 0.18)",
      "colorSuccessText": "#A8E6CF",
      "colorWarning": "#F2A868",
      "colorWarningSoft": "rgba(242, 168, 104, 0.18)",
      "colorWarningText": "#FFD3B6",
      "colorError": "#DB5B76",
      "colorErrorSoft": "rgba(219, 91, 118, 0.18)",
      "colorErrorText": "#F3A9B8",
      "colorInfo": "#9F87E0",
      "colorInfoSoft": "rgba(159, 135, 224, 0.18)",
      "colorInfoText": "#D3C4F0",
      "borderSubtle": "#362C54",
      "borderDefault": "#4A3D6E",
      "borderStrong": "#B9A6EC",
      "borderFocus": "#B9A6EC",
      "shadowXs": "0 1px 2px rgba(0, 0, 0, 0.30)",
      "shadowSm": "0 2px 8px rgba(0, 0, 0, 0.35)",
      "shadowMd": "0 8px 24px rgba(0, 0, 0, 0.45)",
      "shadowLg": "0 16px 48px rgba(0, 0, 0, 0.55)",
      "shadowFocus": "0 0 0 4px rgba(159, 135, 224, 0.45)"
    }
  }
}
