{
  "$meta": {
    "name": "Manifest Design System Tokens",
    "direction": "Lavender Mist",
    "themes": ["light", "dark"],
    "note": "Base ramps are theme-invariant hue anchors. Semantic tokens resolve per theme. Values below are the resolved hex/rgba for each theme; where a token is a var() alias in CSS, the resolved literal is given here for tooling."
  },
  "font": {
    "sans": "'Nunito', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'JetBrains Mono', 'SF Mono', Consolas, monospace"
  },
  "fontSize": {
    "xs": "13px", "sm": "15px", "base": "17px", "lg": "20px",
    "xl": "24px", "2xl": "30px", "3xl": "38px", "4xl": "48px"
  },
  "fontWeight": {
    "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "display": 800
  },
  "lineHeight": { "tight": 1.2, "snug": 1.35, "normal": 1.5, "relaxed": 1.6 },
  "letterSpacing": { "tight": "-0.01em", "normal": "0", "wide": "0.02em" },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },
  "radius": {
    "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "pill": "999px"
  },
  "layout": { "contentMaxWidth": "1120px", "sidebarWidth": "280px" },
  "blur": { "sm": "8px", "md": "18px", "lg": "32px" },
  "motion": {
    "easeStandard": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeBounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "durationFast": "120ms", "durationBase": "200ms", "durationSlow": "360ms"
  },
  "ramps": {
    "purple": {
      "50": "#F9F6FE", "100": "#F0EAFC", "200": "#E3DAF7", "300": "#D3C4F0",
      "400": "#B9A6EC", "500": "#9F87E0", "600": "#8570C9", "700": "#6B58A8",
      "800": "#4A3B78", "900": "#372A5C"
    },
    "mint": { "50": "#F2FBF7", "100": "#E5F7EE", "300": "#A8E6CF", "500": "#5FBE97", "700": "#215B45" },
    "peach": { "50": "#FFF8F2", "100": "#FFF1E6", "300": "#FFD3B6", "500": "#F2A868", "700": "#7A3E12" },
    "coral": { "100": "#FBE7EB", "300": "#F3A9B8", "500": "#DB5B76", "700": "#7A2438" },
    "gray": {
      "0": "#FFFFFF", "50": "#FBFAFE", "100": "#F4F1FB", "200": "#E9E4F5",
      "300": "#D8D0EA", "400": "#B9AFD1", "600": "#7C7196", "800": "#4A3B78", "900": "#2E2547"
    }
  },
  "semantic": {
    "light": {
      "bgPageFlat": "#F7F3FD",
      "bgPage": "linear-gradient(160deg, #EFE9FB 0%, #F7F3FD 50%, #EAF6F0 100%)",
      "surfaceCard": "#FFFFFF",
      "surfaceCardTint": "#F9F6FE",
      "surfaceSunken": "#F4F1FB",
      "canvasBg": "#EFEAF9",
      "canvasGlow": "rgba(159, 135, 224, 0.20)",
      "canvasDot": "rgba(107, 88, 168, 0.20)",
      "surfaceGlass": "rgba(255, 255, 255, 0.55)",
      "surfaceGlassStrong": "rgba(255, 255, 255, 0.75)",
      "surfaceGlassSubtle": "rgba(255, 255, 255, 0.35)",
      "surfaceGlassBorder": "rgba(255, 255, 255, 0.60)",
      "surfaceGlassBorderSoft": "rgba(78, 58, 130, 0.08)",
      "glassFill": "rgba(255, 255, 255, 0.12)",
      "glassShine": "rgba(255, 255, 255, 0.30)",
      "glassGloss": "rgba(255, 255, 255, 0.04)",
      "glassShineEdge": "rgba(255, 255, 255, 0.60)",
      "glassGlossBorder": "rgba(255, 255, 255, 0.45)",
      "textPrimary": "#372A5C",
      "textSecondary": "#4A3B78",
      "textTertiary": "#7C7196",
      "textOnPrimary": "#FFFFFF",
      "textDisabled": "#B9AFD1",
      "textLink": "#6B58A8",
      "textLinkHover": "#4A3B78",
      "colorPrimary": "#9F87E0",
      "colorPrimaryHover": "#8570C9",
      "colorPrimaryActive": "#6B58A8",
      "colorPrimarySoft": "#F0EAFC",
      "colorSecondary": "#5FBE97",
      "colorSecondarySoft": "#E5F7EE",
      "colorAccent": "#F2A868",
      "colorAccentSoft": "#FFF1E6",
      "colorSuccess": "#5FBE97",
      "colorSuccessSoft": "#E5F7EE",
      "colorSuccessText": "#215B45",
      "colorWarning": "#F2A868",
      "colorWarningSoft": "#FFF1E6",
      "colorWarningText": "#7A3E12",
      "colorError": "#DB5B76",
      "colorErrorSoft": "#FBE7EB",
      "colorErrorText": "#7A2438",
      "colorInfo": "#9F87E0",
