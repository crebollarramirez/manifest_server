      "shadowXs": "0 1px 2px rgba(74, 59, 120, 0.06)",
      "shadowSm": "0 2px 8px rgba(74, 59, 120, 0.08)",
      "shadowMd": "0 8px 24px rgba(74, 59, 120, 0.12)",
      "shadowLg": "0 16px 48px rgba(74, 59, 120, 0.16)",
      "shadowFocus": "0 0 0 4px rgba(159, 135, 224, 0.35)"
    },
    "dark": {
      "bgPageFlat": "#1D1730",
      "bgPage": "linear-gradient(160deg, #211A38 0%, #2A2147 50%, #1D2A26 100%)",
      "surfaceCard": "#241D3C",
      "surfaceCardTint": "#2C2449",
      "surfaceSunken": "#191430",
      "canvasBg": "#0C0D12",
