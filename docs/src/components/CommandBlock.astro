---
interface Props {
	command: string;
	label?: string;
}

const { command, label = 'Command' } = Astro.props;
---

<div class="command-block">
	<div class="command-block__bar">
		<span>{label}</span>
		<button type="button" data-copy-command data-command={command}>Copy</button>
	</div>
	<pre><code>{command}</code></pre>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach((button) => {
		button.addEventListener('click', async () => {
			const command = button.dataset.command;
			if (!command) return;
			try {
				await navigator.clipboard.writeText(command);
				button.textContent = 'Copied';
				window.setTimeout(() => { button.textContent = 'Copy'; }, 1500);
			} catch {
				button.textContent = 'Select text';
			}
		});
	});
</script>
