---
import ArchitecturePage from '../../components/ArchitecturePage.astro';
import BoundaryMatrix from '../../components/service-docs/BoundaryMatrix.astro';
import FailureMatrix from '../../components/service-docs/FailureMatrix.astro';
import KeyGuarantees from '../../components/service-docs/KeyGuarantees.astro';
import OperationsAndSource from '../../components/service-docs/OperationsAndSource.astro';
import ServiceAtGlance from '../../components/service-docs/ServiceAtGlance.astro';
import cadToolWorker from '../../data/architecture/cad-tool-worker.json';
import '../../styles/service-docs.css';

const guarantees = [
	{ title: 'No model reasoning or commit authority', description: 'The worker receives a durable bounded job; it owns no OpenAI client, prompts, edit workflow completion, or canonical-source promotion.', evidence: 'workers/cad_editor/tool_worker.py and workers/cad_editor/cad_editor/tool_executor.py' },
	{ title: 'One plan produces at most one candidate', description: 'All operations are validated and applied in memory. A candidate is uploaded only after the entire plan and final source contract pass.', evidence: 'workers/cad_editor/cad_editor/tool_executor.py — CadToolExecutor.apply_plan' },
	{ title: 'Part scope and source identity are enforced', description: 'The linked requested part is authoritative; source hashes, target fingerprints, and allowed targets must still match before mutation.', evidence: 'workers/cad_editor/cad_editor/context_builder.py and workers/cad_editor/cad_editor/tool_executor.py' },
	{ title: 'System-owned code is protected', description: 'Required imports and model contract elements remain protected; eligible deletion requires a PART region or CAD-AGENT provenance.', evidence: 'workers/cad_editor/cad_editor/tool_executor.py — source-contract and deletion validation' },
];

const failures = [
	{ condition: 'No part can be resolved, linked source is stale, or project resolution is ambiguous', durableOutcome: 'The cad_tool_jobs row records a bounded failure.', runtime: 'Context preparation stops before planning or mutation.', downstream: 'No candidate is uploaded.' },
	{ condition: 'Plan version, tool, target, fingerprint, scope, or impact review is invalid', durableOutcome: 'The tool job fails with a typed workflow error.', runtime: 'The transaction is rejected before a durable candidate write.', downstream: 'Canonical source remains unchanged.' },
	{ condition: 'An operation fails after earlier in-memory operations', durableOutcome: 'The tool job is failed.', runtime: 'The in-memory candidate is discarded.', downstream: 'No partial candidate is visible to validation.' },
	{ condition: 'Lease heartbeat is lost', durableOutcome: 'The worker does not claim completion ownership.', runtime: 'Execution raises a lease failure.', downstream: 'The control plane can observe the durable job outcome.' },
];
---

<ArchitecturePage title="CAD Tool Worker" summary="The isolated Python CAD-edit microservice prepares bounded source context and transactionally executes registered tool plans without OpenAI, orchestration, or canonical-commit authority." section="Service view" active="cad-editor" document={cadToolWorker} fallback="Loading the CAD Tool Worker diagram…" showExampleNotice={false} sidebarNote="Production CAD-edit microservice: deterministic context, source policy, in-memory AST/source mutation, and isolated candidate upload.">
	<div slot="beforeDiagram">
		<ServiceAtGlance items={[
			{ label: 'Trigger', value: 'Leased prepare_context or apply_plan row in cad_tool_jobs' },
			{ label: 'Reads', value: 'Canonical model.py, params.json, and bounded job payload' },
			{ label: 'Produces', value: 'Structured context/result or one edit-scoped candidate model.py' },
			{ label: 'Does not own', value: 'OpenAI prompts, public progress, validation proof, canonical commit, reindex, or export' },
			{ label: 'Execution', value: 'One polling Python process with a heartbeat for the leased job' },
		]} />
		<article class="doc-prose">
			<h2>Purpose and boundary</h2>
			<p><code>workers/cad_editor/</code> is a standalone Python microservice, not an internal module of <code>services/cad_agent/</code>. The NestJS CAD Agent inserts durable handoff rows; this worker claims them, returns deterministic context, or applies a server-produced ToolPlan. It never contacts OpenAI and cannot commit canonical <code>model.py</code>.</p>
			<p>For <code>prepare_context</code>, the worker preserves a linked <code>requested_part_id</code> as authoritative. Only unlinked requests can use project-wide semantic resolution, and ambiguity fails closed. For <code>apply_plan</code>, it rechecks source identity, scope, fingerprints, ownership restrictions, and the complete source contract before one candidate is written.</p>
			<h2>Execution paths</h2>
			<ol><li>Claim and heartbeat one <code>cad_tool_jobs</code> row.</li><li>Build bounded context or validate the entire versioned tool plan.</li><li>For a plan, apply every allowed operation only in memory.</li><li>Upload one complete candidate to the edit-scoped prefix, then complete the durable handoff row.</li></ol>
		</article>
		<BoundaryMatrix owns={['Bounded context extraction, source fingerprints, allowed targets, and dependency impact inputs.', 'Transactional in-memory AST/source operations and isolated candidate upload.', 'Tool-job lease heartbeat and typed completion/failure result.']} doesNotOwn={['HTTP/WebSocket submission, idempotency, public progress replay, or edit_jobs orchestration.', 'OpenAI reasoning, prompt loading, repair planning, validation proof, canonical commit, reindexing, or export.', 'Unrestricted source writing, arbitrary shell/Python execution, or durable storage credentials for a model.']} dependsOn={['Postgres cad_tool_jobs lifecycle RPCs.', '3dProjects canonical source and edit-scoped candidate storage.', 'The separate NestJS CAD Agent as its only workflow producer/consumer.']} />
	</div>
	<KeyGuarantees items={guarantees} />
	<FailureMatrix items={failures} />
	<OperationsAndSource facts={[{ label: 'Polling', value: 'CAD_TOOL_JOB_POLL_INTERVAL_SECONDS defaults to 2 seconds.' }, { label: 'Lease', value: 'CAD_TOOL_LEASE_SECONDS defaults to 300; a background heartbeat renews it while a job executes.' }, { label: 'Observe', value: 'Queue age, claim failures, lease loss, context rejection codes, tool rejection codes, candidate upload outcomes, and job duration.' }]} sources={[{ path: 'workers/cad_editor/tool_worker.py', symbol: 'main / execute_with_heartbeat', description: 'Polling, claim, lease, terminal result, and bounded failure handling.' }, { path: 'workers/cad_editor/cad_editor/context_builder.py', symbol: 'ContextBuilder', description: 'Bounded source context and target inventory.' }, { path: 'workers/cad_editor/cad_editor/tool_executor.py', symbol: 'CadToolExecutor', description: 'Plan validation, transactional mutation, and candidate upload.' }, { path: 'workers/cad_editor/cad_editor/repository.py', symbol: 'SupabaseEditRepository', description: 'Storage and database boundary used by the worker.' }]} />
</ArchitecturePage>
