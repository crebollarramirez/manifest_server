---
import ArchitecturePage from '../../components/ArchitecturePage.astro';
import BoundaryMatrix from '../../components/service-docs/BoundaryMatrix.astro';
import FailureMatrix from '../../components/service-docs/FailureMatrix.astro';
import KeyGuarantees from '../../components/service-docs/KeyGuarantees.astro';
import OperationsAndSource from '../../components/service-docs/OperationsAndSource.astro';
import ServiceAtGlance from '../../components/service-docs/ServiceAtGlance.astro';
import cadToolWorker from '../../data/architecture/cad-tool-worker.json';
import '../../styles/service-docs.css';

const guarantees = [
	{ title: 'Nest never sees CAD reasoning', description: 'Agent 3D owns its own OpenAI client, prompts, tool catalog, and commit authority end to end — there is no round trip back to Nest mid-job.', evidence: 'workers/agent_3d/agent_3d.py and orchestrator.py' },
	{ title: 'The goal is never mutated', description: 'Only step status changes (pending → in_progress → completed) as the plan advances. Adding, replacing, or reordering steps is not implemented.', evidence: 'workers/agent_3d/orchestrator.py — EditWorkflowOrchestrator._run_agent_loop' },
	{ title: 'Tools only ever touch the candidate', description: 'Every mutating tool call is scoped to an edit-job-specific candidate path; canonical source is never written while the loop runs.', evidence: 'workers/agent_3d/orchestrator.py — EditWorkflowOrchestrator._prepare_candidate' },
	{ title: 'A step cannot be declared complete over nothing built', description: 'request_step_completion is rejected with STEP_REQUIRES_A_FEATURE when a required-criterion step addresses a candidate with zero CAD features.', evidence: 'workers/agent_3d/orchestrator.py — EditWorkflowOrchestrator._run_agent_loop' },
	{ title: 'Commit is proof- and hash-guarded', description: 'Canonical source is written only after independent validation passes and canonical still matches the accepted base hash; otherwise SOURCE_CHANGED.', evidence: 'workers/agent_3d/orchestrator.py — EditWorkflowOrchestrator._commit_candidate' },
	{ title: 'Reindex is mandatory, export is not', description: 'A failed reindex rolls canonical source back and fails the job; a failed export only adds a warning to an otherwise successful result.', evidence: 'workers/agent_3d/orchestrator.py — _reindex_after_commit / _queue_export_after_commit' },
];

const failures = [
	{ condition: 'Clarification is required for an ambiguous request', durableOutcome: 'The job ends with CLARIFICATION_REQUIRED before any plan or candidate exists.', runtime: 'Goal creation stops; no source is touched.', downstream: 'No candidate, validation, or commit occurs.' },
	{ condition: 'A decision requests no tool call, or a step/job turn cap is exceeded', durableOutcome: 'AGENT_NO_ACTION / AGENT_STEP_TURN_LIMIT / AGENT_TURN_LIMIT.', runtime: 'The loop stops mid-plan rather than guessing at completion.', downstream: 'The commit pipeline is never reached.' },
	{ condition: 'Independent validation fails', durableOutcome: 'VALIDATION_FAILED — the job fails outright.', runtime: 'No repair loop feeds diagnostics back to Agent3D for another try.', downstream: 'Canonical source is untouched.' },
	{ condition: 'Canonical source no longer matches the accepted base hash at commit time', durableOutcome: 'SOURCE_CHANGED.', runtime: 'Commit is refused rather than overwriting an unexpected base.', downstream: 'Canonical source is untouched.' },
	{ condition: 'Post-commit reindex fails', durableOutcome: 'REINDEX_FAILED, after a guarded rollback to the pre-edit backup.', runtime: 'Commit is undone only if canonical still equals this job’s candidate and the backup still equals the accepted hash.', downstream: 'Export is never queued.' },
];
---

<ArchitecturePage title="Agent 3D Worker" summary="The standalone Python microservice that owns everything CAD-specific: goal creation, semantic planning, the Agent3D reasoning loop, validation, hash-guarded commit, mandatory reindex, and best-effort export." section="Service view" active="cad-editor" document={cadToolWorker} fallback="Loading the Agent 3D diagram…" showExampleNotice={false} sidebarNote="Production Agent 3D microservice: goal/plan creation, the Agent3D tool-calling loop, and the commit-through-export pipeline.">
	<div slot="beforeDiagram">
		<ServiceAtGlance items={[
			{ label: 'Trigger', value: 'Leased row from Postgres edit_jobs (claim_next_edit_job, FOR UPDATE SKIP LOCKED)' },
			{ label: 'Owns', value: 'Goal creation, semantic planning, the Agent3D loop, validation coordination, commit, reindex, export' },
			{ label: 'Reads/writes', value: 'An edit-scoped candidate model.py; canonical source only at guarded commit time' },
			{ label: 'Does not own', value: 'WebSocket transport, idempotent job creation, or linked-mesh generation — that is Nest' },
			{ label: 'Execution', value: 'One polling Python process per replica, unique worker ID, heartbeat-renewed lease' },
		]} />
		<article class="doc-prose">
			<h2>Purpose and boundary</h2>
			<p><code>workers/agent_3d/</code> is a standalone Python microservice, not an internal module of <code>services/cad_agent/</code>. It replaced the previous <code>workers/cad_editor</code> Python worker and the TypeScript <code>reasoner.service.ts</code>/<code>orchestrator.service.ts</code> planning path entirely — Nest now creates a durable <code>edit_jobs</code> row and stops; this worker claims it and does everything else.</p>
			<p>A claimed job creates a structured goal, then a high-level plan using two read-only semantic-index tools. It then runs the <a href="/workflows/cad-thinking/">Agent3D reasoning loop</a> — one model call per turn, tool calls executed against an isolated candidate — until every plan step is completed. Only then does it validate the final candidate, commit it to canonical source with a hash-guarded write, reindex, and queue export.</p>
			<h2>Execution paths</h2>
			<ol>
				<li>Claim and heartbeat one <code>edit_jobs</code> row.</li>
				<li>Create and checkpoint the goal, then the high-level plan.</li>
				<li>Bootstrap an edit-scoped candidate from accepted source; back up the pre-edit original.</li>
				<li>Run the plan-driven agent loop until every step is <code>completed</code>.</li>
				<li>Validate, commit, reindex, and queue export for the final candidate.</li>
			</ol>
		</article>
		<BoundaryMatrix owns={['Goal and plan creation, the full Agent3D tool-calling loop, and the registered tool catalog.', 'Candidate lifecycle: bootstrap, mutation, validation coordination, hash-guarded commit, reindex, best-effort export.', 'Job lease heartbeat, private history checkpoints, and public progress events for its claimed job.']} doesNotOwn={['WebSocket transport, HTTP status, idempotent job creation, or linked-mesh generation — all owned by Nest.', 'CAD geometry execution itself — CadQuery/OpenCascade only ever runs inside the separate CAD Validator container.', 'Plan revision (adding/reordering/blocking steps) and a validation repair loop — not implemented yet.']} dependsOn={['Postgres edit_jobs and edit_job_events lifecycle RPCs.', '3dProjects canonical source and edit-scoped candidate storage.', 'The separate NestJS CAD Agent (job producer only), CAD Validator, Indexer, and CAD Exporter.']} />
	</div>
	<KeyGuarantees items={guarantees} />
	<FailureMatrix items={failures} />
	<OperationsAndSource facts={[{ label: 'Polling', value: 'CAD_EDITOR_JOB_POLL_INTERVAL_SECONDS controls how often a replica looks for a claimable job.' }, { label: 'Lease', value: 'CAD_EDITOR_LEASE_SECONDS defaults to 300; a heartbeat renews it while a job runs.' }, { label: 'Turn caps', value: 'MAX_STEP_TURNS = 10 per plan step, MAX_AGENT_TURNS = 24 per job.' }, { label: 'Model', value: 'OPENAI_AGENT_MODEL falls back to OPENAI_MODEL, then gpt-5.4-mini.' }, { label: 'Trace', value: 'One append-only logs/<edit_job_id>.trace.jsonl per job records every llm.request/response and tool.started/completed event.' }, { label: 'Scale', value: 'docker compose ... up --scale agent-3d=4 — replicas add parallelism across parts/projects, not within one job.' }]} sources={[{ path: 'workers/agent_3d/edit_worker.py', symbol: 'main / build_runtime', description: 'Polling, claim, lease heartbeat, and tool registry wiring.' }, { path: 'workers/agent_3d/orchestrator.py', symbol: 'EditWorkflowOrchestrator', description: 'Goal/plan creation, the agent loop, and the commit-through-export pipeline.' }, { path: 'workers/agent_3d/agent_3d.py', symbol: 'Agent3D.decide', description: 'The one-model-call-per-turn reasoning decision.' }, { path: 'workers/agent_3d/planning/planning_agent.py', symbol: 'PlanningAgent', description: 'Bounded read-only tool loop producing the high-level CadPlan.' }, { path: 'workers/agent_3d/tools/registry.py', symbol: 'ToolRegistry / ToolExecutor', description: 'Tool registration, schema validation, and execution.' }]} />
</ArchitecturePage>
