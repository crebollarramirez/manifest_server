---
import ArchitecturePage from '../../components/ArchitecturePage.astro';
import BoundaryMatrix from '../../components/service-docs/BoundaryMatrix.astro';
import KeyGuarantees from '../../components/service-docs/KeyGuarantees.astro';
import OperationsAndSource from '../../components/service-docs/OperationsAndSource.astro';
import ServiceAtGlance from '../../components/service-docs/ServiceAtGlance.astro';
import cadAgent from '../../data/architecture/cad-editor.json';
import '../../styles/service-docs.css';

const guarantees = [
	{ title: 'Nest never reasons about CAD', description: 'The gateway and controller validate transport-level shape and project/part linkage only; no OpenAI client, prompt, or CAD contract lives in services/cad_agent.', evidence: 'services/cad_agent/src/cad-edits.gateway.ts — CadEditsGateway.submit' },
	{ title: 'Idempotent job creation', description: 'A repeated client_request_id with the same request fingerprint returns the existing job instead of creating a duplicate; reusing the ID for different content is rejected.', evidence: 'services/cad_agent/src/submission.service.ts — SubmissionService.submit' },
	{ title: 'Linked mesh parts never enter the CAD workflow', description: 'The gateway branches on part_type before SubmissionService is called, so a mesh part is generated and exported entirely inside Nest.', evidence: 'services/cad_agent/src/cad-edits.gateway.ts — CadEditsGateway.submit' },
	{ title: 'Durable orchestration outlives clients', description: 'edit_jobs and edit_job_events are the entire source of truth. Disconnecting a WebSocket never cancels, pauses, or loses a running job.', evidence: 'services/cad_agent/src/cad-edits.gateway.ts — CadEditsGateway.handleDisconnect' },
	{ title: 'Replay never re-delivers or skips events', description: 'Each subscription tracks its own high watermark; events produced while replaying are buffered and flushed once the snapshot is sent.', evidence: 'services/cad_agent/src/cad-edits.gateway.ts — CadEditsGateway.replay' },
	{ title: 'Reasoning and commit authority live in Python, not Nest', description: 'Goal creation, planning, the Agent3D tool-calling loop, validation, canonical commit, reindex, and export are all owned by the separate Agent 3D worker.', evidence: 'workers/agent_3d/orchestrator.py — EditWorkflowOrchestrator' },
];
---

<ArchitecturePage title="CAD Agent" summary="The NestJS CAD Agent is a lightweight control plane: request validation, idempotent job creation, linked-mesh generation, and durable-progress replay. It performs no CAD reasoning or source mutation — the separate Agent 3D Python worker does that." section="Service view" active="cad-agent" document={cadAgent} fallback="Loading the CAD Agent diagram…" showExampleNotice={false} sidebarNote="Production CAD Agent service: WebSocket/HTTP transport, idempotent job creation, linked-mesh generation, and durable-progress replay only.">
	<div slot="beforeDiagram">
		<ServiceAtGlance items={[{ label: 'Public boundary', value: 'HTTP administrative actions and status; WebSocket-only CAD/mesh submission and progress' }, { label: 'CAD reasoning', value: 'None — Nest creates one edit_jobs row and stops; Agent 3D (Python) claims it separately' }, { label: 'Catalog', value: 'Project and part CRUD plus Storage lifecycle' }, { label: 'Durable truth', value: 'Postgres edit_jobs + edit_job_events; no nested tool-call queue exists anymore' }, { label: 'Mesh path', value: 'Linked mesh-type parts are generated and exported entirely inside Nest, never through edit_jobs' }, { label: 'Mutation boundary', value: 'Agent 3D (Python) owns goal, plan, tool execution, validation, commit, reindex, and export' }]} />
		<article class="doc-prose">
			<h2>Purpose and boundary</h2>
			<p><code>services/cad_agent/</code> is the sole CAD Agent API runtime, and today it is intentionally thin. Its HTTP action endpoint serves catalog, manual jobs, status, and deletion. Free-form CAD and linked-mesh requests enter only through <code>/v1/cad-edits/ws</code>. On <code>cad.edit.submit</code>, the gateway validates the payload and project/part linkage; a linked part with <code>part_type = "mesh"</code> is routed to <code>MeshGenerationService</code> and never becomes an edit job. Otherwise <code>SubmissionService</code> creates or returns one idempotent <code>edit_jobs</code> row and the gateway acknowledges immediately with <code>cad.edit.accepted</code>.</p>
			<p>Nest does not call OpenAI for CAD requests, does not read or write CAD source, does not run a tool-execution loop, and does not decide commit. All of that now lives in the separate <a href="/services/cad-editor/">Agent 3D Python worker</a>, which independently claims queued <code>edit_jobs</code> rows, leases them, and owns the entire reasoning-through-commit lifecycle. See the <a href="/workflows/cad-thinking/">reasoning loop</a> for how that worker actually decides what to do.</p>
			<h2>Public progress contract</h2>
			<p>Clients may read durable status over HTTP or subscribe to <code>/v1/cad-edits/ws</code>. <code>ProgressService</code> polls <code>edit_job_events</code> on an interval and fans new sequences out to matching subscriptions — one RPC batch covers up to 100 subscribed jobs with an independent cursor per job. Each event is persisted with an increasing sequence before delivery. Reconnecting with <code>after_sequence</code> receives a snapshot plus missed events, never prompts, source bodies, credentials, or private reasoning.</p>
		</article>
		<BoundaryMatrix owns={['Project and part actions, Storage lifecycle, and explicit job operations over HTTP.', 'WebSocket transport, request validation, idempotent job creation, linked-mesh generation, and durable-progress replay.', 'HTTP status and WebSocket snapshot-plus-replay delivery.']} doesNotOwn={['CAD goal/plan creation, the Agent3D reasoning loop, or any registered CAD tool.', 'Semantic-index construction, CAD validity execution, canonical commit, reindexing, or export rendering.', 'Worker job claiming, lease heartbeats, or candidate/source storage writes.']} dependsOn={['Postgres projects, parts, edit_jobs, edit_job_events, index_jobs, and generation_jobs.', '3dProjects canonical storage (read-only from Nest’s perspective).', 'The separate Agent 3D worker, Indexer, CAD Validator, and CAD Exporter.']} />
	</div>
	<KeyGuarantees items={guarantees} />
	<OperationsAndSource facts={[{ label: 'Actions', value: 'POST /v1/cad-agent/actions serves catalog, jobs, status, and deletion; it rejects conversations.' }, { label: 'CAD HTTP', value: 'GET /v1/cad-edits/:jobId?after_sequence=N reads durable status and event replay; there is no HTTP submission route.' }, { label: 'WebSocket', value: '/v1/cad-edits/ws accepts cad.edit.submit/subscribe/unsubscribe/ack and pushes cad.edit.accepted, cad.edit.snapshot, cad.edit.progress, and cad.edit.error.' }, { label: 'Mesh events', value: 'A linked mesh part receives cad.mesh.accepted instead of an edit-job lifecycle.' }, { label: 'Progress polling', value: 'CAD_AGENT_EVENT_POLL_INTERVAL_MS controls how often ProgressService checks edit_job_events for new sequences.' }, { label: 'No nested queue', value: 'The historical cad_tool_jobs handoff table was dropped by the cutover migration; edit_jobs is the only durable workflow row.' }]} sources={[{ path: 'services/cad_agent/src/cad-actions.controller.ts', symbol: 'CadActionsController', description: 'Catalog, jobs, status, and deletion actions.' }, { path: 'services/cad_agent/src/cad-edits.gateway.ts', symbol: 'CadEditsGateway', description: 'WebSocket submission, replay, and live delivery.' }, { path: 'services/cad_agent/src/cad-edits.controller.ts', symbol: 'CadEditsController.status', description: 'HTTP durable status and event replay.' }, { path: 'services/cad_agent/src/submission.service.ts', symbol: 'SubmissionService', description: 'Idempotent edit_jobs creation.' }, { path: 'services/cad_agent/src/mesh-generation.service.ts', symbol: 'MeshGenerationService', description: 'Linked mesh part generation and export queueing.' }, { path: 'services/cad_agent/src/progress.service.ts', symbol: 'ProgressService', description: 'Durable-event polling and fan-out.' }]} />
</ArchitecturePage>
