---
import ArchitecturePage from '../../components/ArchitecturePage.astro';
import BoundaryMatrix from '../../components/service-docs/BoundaryMatrix.astro';
import KeyGuarantees from '../../components/service-docs/KeyGuarantees.astro';
import OperationsAndSource from '../../components/service-docs/OperationsAndSource.astro';
import ServiceAtGlance from '../../components/service-docs/ServiceAtGlance.astro';
import cadAgent from '../../data/architecture/cad-editor.json';
import '../../styles/service-docs.css';

const guarantees = [
	{ title: 'Planning stops before execution', description: 'A WebSocket CAD request creates and logs an in-memory goal and version-1 plan, then stops without edit-job, source, candidate, validation, or plan persistence.', evidence: 'services/cad_agent/src/orchestrator.service.ts — createGoalAndPlan' },
	{ title: 'Planning context is read-only', description: 'The planning model receives only semantic-index search and exact feature-context tools; unsupported target bindings are removed.', evidence: 'services/cad_agent/src/planning-agent.service.ts and planning-read-tools.service.ts' },
	{ title: 'Durable orchestration outlives clients', description: 'edit_jobs is the workflow source of truth and edit_job_events is the ordered replay log. A WebSocket only delivers persisted state.', evidence: 'services/cad_agent/src/orchestrator.service.ts and services/cad_agent/src/cad-edits.gateway.ts' },
	{ title: 'Reasoning cannot mutate source', description: 'OpenAI returns a strict versioned ToolPlan; the separate Python worker validates and executes registered operations, while Nest alone decides commit.', evidence: 'services/cad_agent/src/reasoner.service.ts and workers/cad_editor/cad_editor/tool_executor.py' },
	{ title: 'Commit is proof and hash guarded', description: 'Nest accepts only a validation proof for the exact candidate and only while canonical source still matches the accepted base hash.', evidence: 'services/cad_agent/src/orchestrator.service.ts — OrchestratorService.commit' },
];
---

<ArchitecturePage title="CAD Agent" summary="The standalone NestJS backend owns catalog and job actions, linked-mesh generation, idempotent CAD edits, durable orchestration, and replayable progress." section="Service view" active="cad-agent" document={cadAgent} fallback="Loading the CAD Agent diagram…" showExampleNotice={false} sidebarNote="Production CAD Agent service: action API, durable orchestration, structured planning, progress replay, proof-gated commit, reindex, and export handoff.">
	<div slot="beforeDiagram">
		<ServiceAtGlance items={[{ label: 'Public boundary', value: 'HTTP administrative actions and status; WebSocket-only agent conversations and progress' }, { label: 'Planning MVP', value: 'In-memory goal, read-only semantic retrieval, version-1 plan, then stop' }, { label: 'Catalog', value: 'Project and part CRUD plus Storage lifecycle' }, { label: 'Durable truth', value: 'Supabase catalog, job tables, and ordered edit_job_events for durable workflows' }, { label: 'Reasoning', value: 'Goal definition, read-only MVP plan, mesh generation, or strict CAD ToolPlan output' }, { label: 'Mutation boundary', value: 'Separate Python CAD Tool Worker for established CAD source' }]} />
		<article class="doc-prose">
			<h2>Purpose and boundary</h2>
			<p><code>services/cad_agent/</code> is the sole CAD Agent API runtime. Its HTTP action endpoint is limited to catalog, manual jobs, status, and deletion. Free-form CAD and linked-mesh requests enter only through WebSocket. The current CAD conversation path creates a server-identified goal, searches the existing semantic index through two read-only tools, creates a server-identified version-1 plan, logs both objects, and stops. It does not submit or execute an edit job.</p>
			<p>The service also retains the durable edit orchestration infrastructure for explicit workflows: OpenAI tool planning, edit-job leasing, progress replay, validation coordination, guarded commit, rollback, reindex, and export handoff. The CAD Tool Worker is a separate microservice reached only through <code>cad_tool_jobs</code>.</p>
			<p>The workflow starts with a durable job reference. Nest ensures a fresh semantic index, queues bounded context preparation, asks OpenAI for a plan, queues transactional execution, requests independent validation, and commits only after proof and source-hash checks. Repair uses the latest isolated candidate, previous plan, and structured diagnostics; temporary repair inputs never become accepted index data.</p>
			<h2>Public progress contract</h2>
			<p>Clients may read durable status over HTTP or subscribe to <code>/v1/cad-edits/ws</code>. Each public event is persisted with an increasing sequence before delivery. Reconnecting with <code>after_sequence</code> receives a snapshot and missed events, without exposing prompts, source bodies, credentials, or private reasoning.</p>
		</article>
		<BoundaryMatrix owns={['Project and part actions, Storage lifecycle, and explicit job operations over HTTP.', 'WebSocket-only CAD and linked-mesh conversations, edit-job state, public progress, OpenAI structured planning, proof verification, commit, rollback, and downstream handoffs.', 'HTTP status and WebSocket snapshot-plus-replay delivery.']} doesNotOwn={['Python AST/source execution or isolated candidate construction.', 'Independent CAD validity execution, semantic-index construction, or export rendering.', 'Worker job claiming, artifact construction, or service-level retry loops.']} dependsOn={['Postgres projects, parts, edit_jobs, edit_job_events, cad_tool_jobs, index_jobs, and generation_jobs.', '3dProjects canonical/candidate storage.', 'OpenAI Responses API, CAD Tool Worker, Indexer, CAD Validator, and CAD Exporter.']} />
	</div>
	<KeyGuarantees items={guarantees} />
	<OperationsAndSource facts={[{ label: 'Actions', value: 'POST /v1/cad-agent/actions serves catalog, jobs, status, and deletion; it rejects conversations.' }, { label: 'CAD HTTP', value: 'GET /v1/cad-edits/:jobId reads durable status and event replay; there is no HTTP submission route.' }, { label: 'WebSocket', value: '/v1/cad-edits/ws creates and logs an in-memory goal and plan, or handles durable progress subscriptions.' }, { label: 'Planner tools', value: 'search_semantic_index and get_semantic_context read semantic_index.json metadata only.' }, { label: 'Planning persistence', value: 'No goal, plan, step, edit-job, or candidate row is created by the MVP planning path.' }, { label: 'Planning model', value: 'OPENAI_PLANNING_MODEL falls back to OPENAI_MODEL and then gpt-5.4-mini.' }]} sources={[{ path: 'services/cad_agent/src/cad-actions.service.ts', symbol: 'CadActionsService', description: 'Compatible catalog, jobs, status, and deletion actions.' }, { path: 'services/cad_agent/src/cad-edits.gateway.ts', symbol: 'CadEditsGateway', description: 'WebSocket request, replay, and live delivery.' }, { path: 'services/cad_agent/src/orchestrator.service.ts', symbol: 'createGoalAndPlan', description: 'Server-owned goal and plan identity plus ordered test logging.' }, { path: 'services/cad_agent/src/planning-agent.service.ts', symbol: 'PlanningAgentService', description: 'Bounded read-only tool loop and structured MVP plan.' }, { path: 'services/cad_agent/src/planning-read-tools.service.ts', symbol: 'PlanningReadToolsService', description: 'Read-only semantic index search and feature context.' }]} />
</ArchitecturePage>
